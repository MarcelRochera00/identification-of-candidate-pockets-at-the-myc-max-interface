open /home/marcel/Github/myc-max-candidate-pockets/crystal_proteins.pdb
set bgColor white
color /A #ed8282
color /B #99c1f1

# --- Cross-validated (score >= 2) residues, in red ---
name flagged /A:917,940,970 | /B:218,254,256
show flagged atoms
style flagged stick
color flagged red
# labels skipped (SHOW_LABELS = False) - add them manually in an
# image editor afterward, using cross_validation_unified.csv as
# the reference for which residue is which.

view
